{
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5432;Database=identity_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "microservices-ecosystem",
    "Audience": "microservices-ecosystem-clients",
    "SigningKey": "REPLACE_WITH_A_STRONG_64_CHAR_MINIMUM_SECRET_STORED_IN_A_VAULT",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
